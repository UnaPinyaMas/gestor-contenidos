[Unit]
Description=TerraHub media center tactil
After=systemd-user-sessions.service sound.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=joviat
WorkingDirectory=/home/joviat/gestor-contenidos
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_TOUCH_MOUSE_EVENTS=0
Environment=PYTHONUNBUFFERED=1
TTYPath=/dev/tty8
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
ExecStartPre=+/usr/bin/chvt 8
ExecStart=/usr/bin/python3 /home/joviat/gestor-contenidos/main.py
ExecStopPost=+/usr/bin/chvt 1
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
KillMode=control-group

[Install]
WantedBy=multi-user.target
